{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitepress/client"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
